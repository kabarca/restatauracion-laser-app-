{
  "name": "restauracion-laser-recordatorios",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "local": "tsx --env-file=.env.local scripts/local.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:push": "dotenv -e .env.local -- prisma db push",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "tsx --env-file=.env.local prisma/seed.ts",
    "db:seed:local": "tsx --env-file=.env.local scripts/seed-local.ts",
    "db:local": "tsx scripts/dev-db.ts",
    "cron:local": "tsx --env-file=.env.local scripts/run-cron-local.ts",
    "verificar": "tsx --env-file=.env.local scripts/verificar-flujos.ts",
    "verificar:tablero": "tsx --env-file=.env.local scripts/verificar-tablero.ts",
    "enviar:prueba": "tsx --env-file=.env.local scripts/enviar-prueba.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.11.17",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "dotenv-cli": "^11.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}

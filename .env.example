# ─────────────────────────────────────────────────────────────────────────────
# Restauración Láser — Sistema de recordatorios de citas
# Copiá este archivo a .env.local y completá los valores. Ver SETUP.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Supabase Postgres) ───────────────────────────────────────
# Project Settings → Database → Connection string.
# DATABASE_URL usa el pooler (puerto 6543, ?pgbouncer=true). DIRECT_URL usa la
# conexión directa (puerto 5432), necesaria para `prisma migrate`.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Supabase Auth ───────────────────────────────────────────────────────────
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# service_role key — SOLO servidor. Se usa para crear miembros del equipo.
SUPABASE_SERVICE_ROLE_KEY=""

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────────────────
# Dejalo vacío para modo dry-run (registra el mensaje sin enviarlo).
# developers.facebook.com → tu app → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# Nombres EXACTOS de las plantillas aprobadas en Meta (categoría Utility).
WHATSAPP_TEMPLATE_CONFIRMACION="confirmacion_cita"
WHATSAPP_TEMPLATE_RECORDATORIO="recordatorio_cita"
# Código de idioma de las plantillas (es o es_CR según cómo se aprobaron).
WHATSAPP_TEMPLATE_LOCALE="es"

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Dejalo vacío para modo dry-run.
RESEND_API_KEY=""
# Remitente. Debe ser de un dominio verificado en Resend.
EMAIL_FROM="Restauración Láser <citas@notificaciones.restauracionlaser.cr>"
# Copia interna del equipo + destino de alertas cuando un envío falla.
EMAIL_EQUIPO="equipo@restauracionlaser.cr"

# ── Datos de contacto que aparecen en los mensajes ──────────────────────────
# Número de WhatsApp que ve el cliente para reprogramar (formato legible).
WHATSAPP_CONTACTO_PUBLICO="+506 8901 9811"

# ── Cron de recordatorios ───────────────────────────────────────────────────
# Secreto que protege /api/cron/recordatorios. Generá uno con: openssl rand -hex 32
CRON_SECRET=""

# ── Comportamiento ──────────────────────────────────────────────────────────
# "true" fuerza dry-run aunque haya credenciales. Por defecto: dry-run solo si
# faltan credenciales.
FORCE_DRY_RUN="false"
# Días por defecto para el recordatorio (se puede sobreescribir por cita).
RECORDATORIO_DIAS_DEFAULT="2"

# URL pública del panel (para links en correos internos).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Solo desarrollo ─────────────────────────────────────────────────────────
# Si se define (y NODE_ENV != production), se entra al panel como ese usuario
# sin pasar por Supabase Auth. NUNCA definir en producción.
# DEV_AUTOLOGIN_EMAIL="admin@local"
